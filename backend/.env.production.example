# ==================================================
# PawConnect AI Backend — Production Environment Variables
# ==================================================

ENVIRONMENT="production"
PROJECT_NAME="PawConnect AI Backend"
SECRET_KEY="generate_a_secure_256bit_random_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
DATABASE_URL="postgresql://pawconnect_user:your_secure_password@postgres_host:5432/pawconnect_db"

# Redis Cache & Rate Limiter
REDIS_URL="redis://redis_host:6379/0"

# Email Provider (Resend API or SMTP)
RESEND_API_KEY="re_123456789_your_resend_api_key"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_EMAIL="noreply@pawconnect.ai"

# SMS Provider (Twilio or MSG91)
TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+18005550199"

MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_template_id"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["https://pawconnect.ai","https://admin.pawconnect.ai"]
